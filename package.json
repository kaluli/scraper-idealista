{
  "name": "scraper-idealista",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-env-dev.js && next dev -p 3000",
    "dev:restart": "lsof -ti :3000 2>/dev/null | xargs kill -9 2>/dev/null; sleep 1; node scripts/check-env-dev.js && next dev -p 3000",
    "dev:clean": "rm -rf .next && node scripts/check-env-dev.js && next dev -p 3000",
    "build": "prisma generate && next build",
    "build:clean": "rm -rf .next && prisma generate && next build",
    "start": "next start",
    "start:3100": "next start -p 3100",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:status": "node scripts/db-status.js",
    "db:wipe:local": "node scripts/wipe-database.js local",
    "db:wipe:production": "node scripts/wipe-database.js production",
    "db:import": "node scripts/import-json.js",
    "db:import-all": "node scripts/import-all.js",
    "db:seed-madrid": "node scripts/seed-madrid-neighborhoods.js",
    "db:seed-madrid:production": "node scripts/seed-madrid-neighborhoods.js production",
    "db:sync-from-prod": "node scripts/sync-local-from-prod.js",
    "db:prod-to-local": "node scripts/sync-local-from-prod.js",
    "db:migrate-mysql-to-neon": "node scripts/migrate-mysql-to-neon.js",
    "db:unify-segovia": "node scripts/unify-segovia-barrios.js",
    "db:sync-to-prod": "node scripts/sync-local-to-prod.js",
    "db:push-vercel": "node scripts/push-local-to-vercel.js",
    "db:pull-vercel": "node scripts/pull-prod-via-vercel.js",
    "import-idealista-html": "node scripts/import-idealista-html.js",
    "backup-prod": "node scripts/backup-prod.js",
    "postinstall": "prisma generate",
    "deploy": "npx vercel --prod"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "clsx": "^2.1.1",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.5.0",
    "mysql2": "^3.22.3",
    "postcss": "^8.5.10",
    "prisma": "^5.7.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  }
}
