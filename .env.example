# Archivo de ejemplo para variables de entorno
# Copia este archivo a .env.local y completa con tus valores

# Base de datos LOCAL (desarrollo)
# Formato: mysql://usuario:password@localhost:3306/nombre_base_datos
DATABASE_URL="mysql://root:tu_password@localhost:3306/idealista_db"

# Base de datos PRODUCCIÓN (Vercel)
# Configurá DATABASE_URL en Vercel → Project → Settings → Environment Variables.
# Usá una MySQL externa, ej: PlanetScale o Railway (solo el servicio MySQL).

# Base de datos PRODUCCIÓN (Railway)
# Si usás Railway para el backend, configurá la variable en Railway → Variables.
